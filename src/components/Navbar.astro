---
import Neko from "./Neko/Neko";
---

<nav>
  <div id="neko"><Neko client:load /></div>
  <a href="/blog">blog</a>
  <a href="/projects">projects</a>
  <a href="/uses">uses</a>
  <a href="/about">about</a>
</nav>

<style>
  nav {
    display: grid;
    grid-template-columns: 3fr repeat(4, 1fr);

    @media (max-width: 1000px) {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas:
        "neko neko neko neko"
        "blog projects uses about";
    }
  }

  nav > * {
    font-family: var(--font-montserrat);
    padding: 1.5rem 0;
    text-align: center;
    border-block-end: 2px solid var(--accent-12);

    @media (max-width: 1000px) {
      padding: 1rem 0;
      border-block-end: 1px solid var(--accent-12);
    }
  }

  #neko {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0;
  }

  a {
    text-decoration: none;
    color: var(--accent-12);
    font-weight: 600;
    font-size: 1.5rem;
    border-inline-start: 2px solid var(--accent-12);

    &:nth-of-type(2n + 1) {
      background-color: var(--gray-8);
    }

    @media (max-width: 1000px) {
      font-size: 1rem;
      border-inline-start: 1px solid var(--accent-12);

      &:nth-of-type(2n + 1) {
        background-color: transparent;
      }

      &:first-of-type {
        border-inline-start: none;
      }
    }
  }

  @media (max-width: 1000px) {
    #neko {
      grid-area: neko;
      padding-block-end: 0.5rem;
    }

    a:nth-of-type(1) {
      grid-area: blog;
      background-color: var(--gray-8);
    }

    a:nth-of-type(2) {
      grid-area: projects;
    }

    a:nth-of-type(3) {
      grid-area: uses;
      background-color: var(--gray-8);
    }

    a:nth-of-type(4) {
      grid-area: about;
    }
  }
</style>
